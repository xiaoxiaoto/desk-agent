{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wecom-use.local/schemas/task-instruction-v1.json",
  "title": "TaskInstruction",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "launch_wecom" } } },
    { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "center_wecom_window" } } },
    { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "capture_app_window" } } },
    { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "const": "locate_app_window_objects" }, "params": { "type": "object", "additionalProperties": false, "required": ["objects"], "properties": { "objects": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S", "description": "Nonblank; at most 256 UTF-8 bytes (enforced by runtime)." } } } } } },
    { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "const": "convert_app_window_coordinates" }, "params": { "type": "object", "additionalProperties": false, "required": ["capture_id", "boxes"], "properties": { "capture_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }, "boxes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 }, "description": "Finite [x1,y1,x2,y2] original image pixels with x1 < x2 and y1 < y2, within capture dimensions; enforced by runtime." } } } } } },
    { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "const": "activate_app_element" }, "params": { "type": "object", "additionalProperties": false, "required": ["point", "expected_role", "expected_label"], "properties": { "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "Finite macOS global top-left logical screen points, exactly representable as f32 and within the live selected WeCom window; enforced by runtime." }, "expected_role": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Exact AXRole; at most 256 UTF-8 bytes, enforced by runtime." }, "expected_label": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Exact AXTitle; at most 256 UTF-8 bytes, enforced by runtime." } } } } },
    { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "const": "diagnose_app_element" }, "params": { "type": "object", "additionalProperties": false, "required": ["point", "expected_role", "expected_label"], "properties": { "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "Finite macOS global top-left logical screen points; precision and window bounds are checked by diagnosis." }, "expected_role": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Exact AXRole; at most 256 UTF-8 bytes, enforced by runtime." }, "expected_label": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Exact AXTitle; at most 256 UTF-8 bytes, enforced by runtime." } } } } },
    { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "const": "search_contact" }, "params": { "type": "object", "additionalProperties": false, "required": ["name", "exact_match"], "properties": { "name": { "type": "string", "minLength": 1 }, "exact_match": { "type": "boolean" } } } } },
    { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "const": "open_chat" }, "params": { "type": "object", "additionalProperties": false, "required": ["contact"], "properties": { "contact": { "type": "string", "minLength": 1 } } } } },
    { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "const": "send_text" }, "params": { "type": "object", "additionalProperties": false, "required": ["content"], "properties": { "content": { "type": "string", "minLength": 1 } } } } },
    { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "verify_message_sent" } } }
  ]
}
